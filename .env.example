# 复制为 .env 后填写。不要把真实密钥提交到仓库。

# development / production。production 下使用默认 BETTER_AUTH_SECRET 会拒绝启动。
APP_ENV=development

# Better Auth。生产环境不要用默认 SECRET。白名单为空则不能注册。
BETTER_AUTH_SECRET=dev-only-change-me
BETTER_AUTH_URL=http://localhost:8000
AUTH_ALLOWED_EMAILS=kkn1sgh@bosch.com
AUTH_PORT=3001
AUTH_DB_PATH=data/auth.sqlite

# 可选：逗号分隔的额外 trusted origin（GitHub Pages、隧道域名等）
BETTER_AUTH_TRUSTED_ORIGINS=

# 忘记密码发信。HOST 和 FROM 都填了才会发邮件。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# 机器入口（curl / OpenAI 兼容接口）。浏览器走登录，不要再用 VITE_API_KEY。
QWEN_TTS_API_KEY=
